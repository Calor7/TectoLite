{
  "name": "tectolite",
  "private": true,
  "version": "1.0.9",
  "productName": "TectoLite",
  "description": "Tectonic Plate Simulation Engine",
  "author": "TectoLite Team",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron-main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:electron": "node --check electron-main.cjs && node --check preload.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.release.config.ts --coverage",
    "test:watch": "vitest",
    "lint": "eslint src",
    "build": "tsc && vite build",
    "verify": "npm run lint && npm run typecheck && npm run check:electron && npm run test && npm run build",
    "preview": "vite preview",
    "icon:render": "electron scripts/render-app-icon.cjs",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "smoke:electron-export": "npm run build && electron . --smoke-export",
    "smoke:electron-export:built": "electron . --smoke-export",
    "package:dir": "electron-builder --dir --publish=never",
    "release:checksums": "node scripts/write-release-checksums.cjs release",
    "dist": "npm run build && electron-builder --win --mac --linux"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/d3-geo": "^3.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.4.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "polygon-clipping": "^0.15.7",
    "sql.js": "^1.10.3"
  }
}
